{
  "name": "espresso",
  "version": "1.0.0",
  "description": "espresso lightweight framework for building apis or mvc",
  "keywords": [
    "rest",
    "api",
    "mvc",
    "framework"
  ],
  "license": "MIT",
  "author": "pragmatica team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "npm run build:js && node --watch src/index.ts",
    "start": "node src/index.ts",
    "build": "npm run build:js && tsc -p tsconfig.json",
    "build:js": "esbuild src/assets/js/*.ts --outdir=src/assets/js --format=esm --target=es2022",
    "watch:js": "esbuild src/assets/js/*.ts --outdir=src/assets/js --format=esm --target=es2022 --watch",
    "preview": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "mongodb": "^7.5.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
